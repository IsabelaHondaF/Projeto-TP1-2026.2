# Doxyfile para o Projeto-TP1-2026.2
PROJECT_NAME           = "Sistema Kanban - TP1 2026.2"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Trabalho Pratico de Tecnicas de Programacao 1 - UnB"
OUTPUT_DIRECTORY       = Documentacao
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Brazilian
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
SUBGROUPING            = YES

# Visão do usuário das classes (documenta interface pública e membros acessíveis)
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

# Entrada de arquivos
INPUT                  = Headers \
                         Dominios \
                         Entidades \
                         Servicos \
                         Repositorios \
                         Apresentacao \
                         Main \
                         README.md \
                         DOCUMENTACAO_CONTROLADORAS.md

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = build obj bin .git
USE_MDFILE_AS_MAINPAGE = README.md

# Formato HTML
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Avisos e relatórios
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

